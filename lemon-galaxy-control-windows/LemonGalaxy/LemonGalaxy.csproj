<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LemonGalaxy Windows 主控端（WPF，.NET Framework 4.8，Win7 SP1 起）。
    界面全部用 C# 代码构建，不含需要编译的 XAML（模板在运行时由 XamlReader 解析），所以 macOS / Linux 上的 .NET SDK 也能编译检查。
    内核绑定 Core/Generated/galaxy_ffi.cs 由仓库根 scripts/gen-csharp-bindings.sh 生成（不进 git）；
    运行时加载 exe 同目录的 galaxy_ffi.dll，没有时退回模拟内核。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LemonGalaxy</RootNamespace>
    <AssemblyName>LemonGalaxy</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Resources\LemonGalaxy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <!-- 信息版本只用「版本+构建号」（build.sh 传入），不让 SDK 自动追加 git 提交号 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>LemonGalaxy</Product>
    <Company>LemonIT.CN</Company>
    <Copyright>Copyright © 2026 LemonIT.CN · MIT License</Copyright>
    <Description>LemonGalaxy 远程控制（Windows 主控端）</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!-- 生成的绑定里可能出现的警告（不改生成代码，在这里统一压掉） -->
    <NoWarn>$(NoWarn);CS1591;CS0618;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- 资源：语言包、终端配色、许可、图标，原样复制到 exe 同目录的 Resources\ -->
  <ItemGroup>
    <None Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 界面直接使用绑定里的记录与枚举（模拟内核也是），所以必须先生成绑定；缺失时给出明确提示 -->
  <Target Name="CheckGeneratedBindings" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\Core\Generated\galaxy_ffi.cs')"
           Text="缺少内核绑定 Core/Generated/galaxy_ffi.cs，请先在仓库根运行 scripts/gen-csharp-bindings.sh" />
  </Target>
</Project>
