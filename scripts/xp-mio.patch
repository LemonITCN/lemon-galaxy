--- a/src/sys/windows/afd.rs
+++ b/src/sys/windows/afd.rs
@@ -14,6 +14,67 @@
 
 const IOCTL_AFD_POLL: u32 = 0x00012024;
 
+/// LemonGalaxy 的 Windows XP 兼容版补丁（scripts/xp-mio.patch，只在 XP 版构建时打）。
+///
+/// XP / Server 2003 没有 NtCancelIoFileEx（YY-Thunks 换成 NtCancelIoFile），而 NtCancelIoFile 只取消
+/// 调用线程自己发出的 I/O。mio 会在任意线程上取消别的线程发出的 AFD 轮询，XP 上取消不掉，这个套接字
+/// 从此等不到要的事件（XP 实测：TLS 握手完成后请求发出去了，响应一直收不到）。所以没有 NtCancelIoFileEx 时，
+/// AFD 轮询的发出与取消都交给同一个专用线程：取消会连带取消同一个 AFD 句柄上别的套接字的轮询，
+/// 它们完成后 mio 照常重新发出，只多一点开销。
+mod xp_affinity {
+    use std::ffi::c_void;
+    use std::sync::mpsc;
+    use std::sync::{Mutex, OnceLock};
+
+    #[link(name = "kernel32")]
+    extern "system" {
+        fn GetModuleHandleA(name: *const u8) -> *mut c_void;
+        fn GetProcAddress(module: *mut c_void, name: *const u8) -> *mut c_void;
+    }
+
+    /// 系统没有 NtCancelIoFileEx（XP / Server 2003）
+    pub fn needed() -> bool {
+        static NEEDED: OnceLock<bool> = OnceLock::new();
+        *NEEDED.get_or_init(|| unsafe {
+            let ntdll = GetModuleHandleA(b"ntdll.dll\0".as_ptr());
+            ntdll.is_null() || GetProcAddress(ntdll, b"NtCancelIoFileEx\0".as_ptr()).is_null()
+        })
+    }
+
+    /// 裸指针要交给专用线程用（调用方同步等它做完，指针在这期间一直有效）
+    pub struct Ptrs<A, B, C, D>(pub A, pub B, pub C, pub D);
+    unsafe impl<A, B, C, D> Send for Ptrs<A, B, C, D> {}
+
+    type Job = Box<dyn FnOnce() + Send>;
+
+    fn sender() -> &'static Mutex<mpsc::Sender<Job>> {
+        static TX: OnceLock<Mutex<mpsc::Sender<Job>>> = OnceLock::new();
+        TX.get_or_init(|| {
+            let (tx, rx) = mpsc::channel::<Job>();
+            std::thread::Builder::new()
+                .name("mio-afd-xp".into())
+                .spawn(move || {
+                    // 一直不退出：线程退出时 XP 会取消它发出的全部 I/O
+                    while let Ok(job) = rx.recv() {
+                        job();
+                    }
+                })
+                .expect("mio: cannot spawn the AFD thread");
+            Mutex::new(tx)
+        })
+    }
+
+    /// 在专用线程上执行并等结果
+    pub fn run<R: Send + 'static>(f: impl FnOnce() -> R + Send + 'static) -> R {
+        let (tx, rx) = mpsc::sync_channel(1);
+        let job: Job = Box::new(move || {
+            let _ = tx.send(f());
+        });
+        sender().lock().unwrap().send(job).expect("mio: the AFD thread is gone");
+        rx.recv().expect("mio: the AFD thread is gone")
+    }
+}
+
 /// Winsock2 AFD driver instance.
 ///
 /// All operations are unsafe due to IO_STATUS_BLOCK parameter are being used by Afd driver during STATUS_PENDING before I/O Completion Port returns its result.
