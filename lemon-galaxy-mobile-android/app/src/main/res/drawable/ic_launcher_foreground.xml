<?xml version="1.0" encoding="utf-8"?>
<!-- 应用图标前景：星球 + 倾斜轨道 + 卫星（柠檬黄绿渐变），108dp 画布，主体落在中间 66dp 安全区内 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-24">
        <!-- 轨道后半圈 -->
        <path
            android:pathData="M23,54 a31,11.5 0 1,1 62,0"
            android:strokeWidth="3"
            android:strokeColor="#7FC6E35A"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
    <!-- 星球 -->
    <path android:pathData="M54,41 a13,13 0 1,1 -0.01,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="44"
                android:startY="42"
                android:endX="64"
                android:endY="66">
                <item android:offset="0" android:color="#FFF2F77A" />
                <item android:offset="1" android:color="#FF5FCB6A" />
            </gradient>
        </aapt:attr>
    </path>
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-24">
        <!-- 轨道前半圈（压在星球上） -->
        <path
            android:pathData="M23,54 a31,11.5 0 0,0 62,0"
            android:strokeWidth="3"
            android:strokeColor="#FFD6EC5C"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- 卫星 -->
        <path
            android:pathData="M85,50.5 a3.5,3.5 0 1,1 -0.01,0 z"
            android:fillColor="#FFF2F77A" />
    </group>
</vector>
